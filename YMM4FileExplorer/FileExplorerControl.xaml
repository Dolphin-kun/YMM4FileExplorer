<UserControl x:Class="YMM4FileExplorer.FileExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YMM4FileExplorer"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:settins="clr-namespace:YMM4FileExplorer.Settings"
             xmlns:helpers="clr-namespace:YMM4FileExplorer.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewMouseDown="FileExplorerControl_PreviewMouseDown">

    <UserControl.Resources>
        <!-- 詳細ListView -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="大きく表示" Click="ShowLargePreview_Click"/>
        </ContextMenu>

        <Style x:Key="DetailsViewItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconViewItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="IconViewTemplate">
            <Grid Width="120" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="{Binding Thumbnail}" Width="96" Stretch="Uniform" VerticalAlignment="Bottom"/>

                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="IconViewItemsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="GridViewColumnHeaderGripper"
            TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                            <Rectangle HorizontalAlignment="Center"
                                    Width="1"
                                    Fill="LightGray"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <GridView x:Key="DetailsView">
            <GridView.ColumnHeaderContainerStyle>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter x:Name="HeaderContent" Margin="10,0,0,1" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Stretch" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Style="{StaticResource GridViewColumnHeaderGripper}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridView.ColumnHeaderContainerStyle>

            <GridViewColumn Width="230">
                <GridViewColumn.Header>
                    <GridViewColumnHeader Tag="Name" Click="GridViewColumnHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="名前"/>
                            <TextBlock Text="" Foreground="Gray" Margin="4,0,0,0"/>
                        </StackPanel>
                    </GridViewColumnHeader>
                </GridViewColumn.Header>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding Path=Type}">
                <GridViewColumn.Header>
                    <GridViewColumnHeader Tag="Type" Click="GridViewColumnHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="種類"/>
                            <TextBlock Text="" Foreground="Gray" Margin="4,0,0,0"/>
                        </StackPanel>
                    </GridViewColumnHeader>
                </GridViewColumn.Header>
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding Path=Size}">
                <GridViewColumn.Header>
                    <GridViewColumnHeader Tag="Size" Click="GridViewColumnHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="サイズ"/>
                            <TextBlock Text="" Foreground="Gray" Margin="4,0,0,0"/>
                        </StackPanel>
                    </GridViewColumnHeader>
                </GridViewColumn.Header>
            </GridViewColumn>
            <GridViewColumn Width="150" DisplayMemberBinding="{Binding Path=LastWriteString}">
                <GridViewColumn.Header>
                    <GridViewColumnHeader Tag="LastWriteTime" Click="GridViewColumnHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="更新日時"/>
                            <TextBlock Text="" Foreground="Gray" Margin="4,0,0,0"/>
                        </StackPanel>
                    </GridViewColumnHeader>
                </GridViewColumn.Header>
            </GridViewColumn>
        </GridView>
    </UserControl.Resources>

    <Grid PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="PreviewColumnSplitter" Width="Auto"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BackButton" Click="BackButton_Click" IsEnabled="False" Width="26" Height="20" Padding="4" Margin="0,0,2,0">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stretch="Uniform" />
                </Button>
                <Button x:Name="ForwardButton" Click="ForwardButton_Click" IsEnabled="False" Width="26" Height="20" Padding="4" Margin="0,0,10,0">
                    <Path Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stretch="Uniform" />
                </Button>
                <Button x:Name="ReloadButton" Click="ReloadButton_Click" Width="26" Height="20" Padding="4">
                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stretch="Uniform" />
                </Button>
            </StackPanel>

            <DockPanel Grid.Column="1" Margin="10,0,10,0">
                <CheckBox x:Name="SearchSubdirectoriesCheckBox" ToolTip="サブフォルダも検索" VerticalAlignment="Center" IsChecked="True" DockPanel.Dock="Right" Margin="5,0,0,0"/>
                <TextBox x:Name="SearchTextBox" VerticalAlignment="Center" KeyDown="SearchTextBox_KeyDown" TextChanged="SearchTextBox_TextChanged" MinWidth="20"/>
            </DockPanel>

            <c:DropDownButton Grid.Column="2" Content="{DynamicResource menu}" Width="20">
                <c:DropDownButton.Style>
                    <Style TargetType="c:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </c:DropDownButton.Style>
                <c:DropDownButton.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="詳細" Click="DetailsView_Click"/>
                        <MenuItem Header="アイコン" Click="IconView_Click"/>
                    </ContextMenu>
                </c:DropDownButton.ContextMenu>
            </c:DropDownButton>
        </Grid>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <c:CommonComboBox x:Name="FavoritesComboBox"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,5"
                      ItemsSource="{Binding Source={x:Static settins:FileExplorerSettings.Default}, Path=Favorites}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="FullPath"
                      ValueChanged="FavoritesComboBox_ValueChanged"/>

            <TreeView x:Name="DirectoryTree"
              SelectedItemChanged="DirectoryTree_SelectedItemChanged"
              ContextMenuOpening="DirectoryTree_ContextMenuOpening"
              MouseDoubleClick="DirectoryTree_MouseDoubleClick">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="AddFavoriteMenuItem" 
                          Header="お気に入りに追加" 
                          Click="AddFavorite_Click"/>
                        <MenuItem x:Name="RemoveFavoriteMenuItem" 
                          Header="お気に入りから削除" 
                          Click="RemoveFavorite_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Width="5"
              Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>

        <Grid Grid.Row="1" Grid.Column="2">
            <ListView Name="DetailsListView" 
                      SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource DetailsViewItemContainerStyle}"
                      View="{StaticResource DetailsView}"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FileList_PreviewMouseMove"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      SelectionChanged="ListView_SelectionChanged"
                      Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            </ListView>

            <ListView x:Name="IconListView"
                      Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Extended"
                      ItemTemplate="{StaticResource IconViewTemplate}"
                      ItemsPanel="{StaticResource IconViewItemsPanel}"
                      ItemContainerStyle="{StaticResource IconViewItemContainerStyle}"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FileList_PreviewMouseMove"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      SelectionChanged="ListView_SelectionChanged"
                      Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            </ListView>
        </Grid>

        <GridSplitter x:Name="LargePreviewSplitter"
                      Grid.Row="1" Grid.Column="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Width="5"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      Visibility="Collapsed"/>

        <DockPanel x:Name="LargePreviewPane"
                   Grid.Row="1" Grid.Column="4"
                   MinWidth="200"
                   Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                   Visibility="Collapsed">
            <Border BorderBrush="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}" BorderThickness="0.5" Margin="5,0,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="5,5,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewName" Grid.Column="0" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Top"/>
                        <Button Content="✕" Click="ClosePreview_Click" Grid.Column="1" Padding="5,2" ToolTip="閉じる" VerticalAlignment="Top"/>
                    </Grid>

                    <ContentControl x:Name="PreviewContentHost" Grid.Row="1" />

                    <Grid x:Name="MediaControlsPanel" Grid.Row="2" Margin="5,0,5,5" Visibility="Collapsed" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PlayButton" Content="▶" Click="PlayButton_Click" Width="40" ToolTip="再生" />
                            <Button x:Name="PauseButton" Content="■" Click="PauseButton_Click" Width="40" ToolTip="一時停止" Visibility="Collapsed" />
                        </StackPanel>

                    </Grid>
                </Grid>
            </Border>
        </DockPanel>


        <Popup x:Name="PreviewPopup"
                Placement="Mouse"
                AllowsTransparency="True"
                PopupAnimation="Fade"
                StaysOpen="False">
            <Border x:Name="PreviewBorder" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}" BorderThickness="1" Padding="10" CornerRadius="8" Width="300" MaxHeight="400">
                <ContentPresenter x:Name="PreviewContent"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
